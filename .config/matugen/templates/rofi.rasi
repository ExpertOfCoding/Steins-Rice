* {
    background:     #{{colors.surface.default.hex_stripped}}bf;
    background-alt: #{{colors.surface_container_high.default.hex_stripped}}bf;
    foreground:     #{{colors.on_surface.default.hex_stripped}}bf;
    selected:       #{{colors.primary.default.hex_stripped}}bf;
    active:         #{{colors.secondary.default.hex_stripped}}bf;
    urgent:         #{{colors.error.default.hex_stripped}}bf;
}